{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Medieval",
  "version": "0.1.0",
  "identifier": "de.moritzbrantner.medieval",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Medieval",
        "width": 1180,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https: wss: http://127.0.0.1:8787 ws://127.0.0.1:8787 http://localhost:8787 ws://localhost:8787"
    }
  },
  "bundle": {
    "active": false
  }
}
