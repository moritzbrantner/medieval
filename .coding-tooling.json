{
  "schemaVersion": 1,
  "profile": "repository-foundation-v1",
  "tiers": {
    "fast": ["format:check", "lint", "build", "test"],
    "standard": ["format:check", "lint", "build", "test"],
    "performance": ["benchmark:smoke"]
  },
  "requiredCapabilities": [
    "format:check",
    "lint",
    "build",
    "test",
    "benchmark:smoke"
  ],
  "capabilityCommands": {
    ".": {
      "benchmark:smoke": [
        "cargo",
        "run",
        "--locked",
        "--release",
        "-p",
        "medieval-core",
        "--example",
        "performance_smoke"
      ]
    }
  },
  "merge": {
    "authority": "hosted",
    "requiredChecks": [
      "rust",
      "web",
      "build",
      "desktop input contract",
      "desktop-shell (ubuntu-22.04)",
      "desktop-shell (macos-latest)",
      "desktop-shell (windows-latest)",
      "asset-contract"
    ]
  }
}
